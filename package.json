{
  "name": "songless",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "audit:songs": "node scripts/song-library.mjs audit",
    "audit:provisional": "node scripts/audit-provisional-catalog.mjs",
    "audit:coverage": "node scripts/audit-billion-coverage.mjs",
    "batch:billion": "node scripts/prepare-billion-download-batch.mjs",
    "approve:song": "node scripts/approve-song.mjs",
    "prepare:media": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-audio.ps1",
    "resolve:youtube": "node scripts/resolve-youtube-sources.mjs",
    "resolve:studio-sources": "node scripts/resolve-studio-sources.mjs",
    "audit:sources": "node scripts/audit-youtube-sources.mjs",
    "download:media": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-authorized-sources.ps1",
    "cache:hosted-media": "node scripts/cache-hosted-media.mjs",
    "audit:media-starts": "node scripts/audit-media-starts.mjs",
    "inspect:clue": "node scripts/inspect-clue-alignment.mjs",
    "audit:source-durations": "node scripts/audit-billion-source-durations.mjs",
    "audit:fingerprints": "node scripts/audit-canonical-fingerprints.mjs",
    "finalize:billion-media": "node scripts/finalize-billion-media.mjs",
    "audit:source-candidates": "node scripts/audit-source-candidates.mjs",
    "audit:spotify-pages": "node scripts/audit-spotify-track-pages.mjs",
    "metadata:deezer": "node scripts/resolve-deezer-metadata.mjs",
    "apply:media-starts": "node scripts/apply-media-start-overrides.mjs",
    "apply:artist-credits": "node scripts/apply-artist-credit-overrides.mjs",
    "init:sources": "node scripts/init-download-sources.mjs",
    "prepare:r2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-r2-media.ps1",
    "check:r2": "node --env-file-if-exists=.env.local scripts/upload-r2-media.mjs --check",
    "upload:r2:dry-run": "node --env-file-if-exists=.env.local scripts/upload-r2-media.mjs --dry-run",
    "sync:r2": "node --env-file-if-exists=.env.local scripts/upload-r2-media.mjs --catalog-only",
    "upload:r2": "node --env-file-if-exists=.env.local scripts/upload-r2-media.mjs",
    "review:r2": "node scripts/build-hosted-review.mjs",
    "metadata:spotify": "node --env-file-if-exists=.env.local scripts/resolve-spotify-metadata.mjs",
    "promote:songs": "node scripts/song-library.mjs promote",
    "apply:intro": "node scripts/apply-intro-scores.mjs",
    "provisional:catalog": "node scripts/apply-media-start-overrides.mjs && node scripts/generate-provisional-catalog.mjs",
    "upload:artwork": "node --env-file-if-exists=.env.local scripts/upload-artwork-r2.mjs",
    "audit:artwork": "node --env-file-if-exists=.env.local scripts/audit-artwork-integrity.mjs",
    "audit:artwork:remote": "node --env-file-if-exists=.env.local scripts/audit-artwork-integrity.mjs --remote",
    "repair:artwork": "node --env-file-if-exists=.env.local scripts/repair-poisoned-artwork-r2.mjs",
    "apply:artwork-overrides": "node --env-file-if-exists=.env.local scripts/apply-artwork-source-overrides.mjs",
    "refresh:longlist": "node scripts/refresh-song-longlist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:hosted": "node scripts/verify-ui.mjs --hosted-smoke",
    "verify:ui:artifacts": "node scripts/verify-ui.mjs --artifacts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^17.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@types/node": "^26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
