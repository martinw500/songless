# Optional metadata-only lookup. Playback never uses Spotify.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Cloudflare R2 upload credentials. Never use a VITE_ prefix for secrets.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=songless-media
R2_PUBLIC_BASE_URL=https://your-public-r2-hostname.r2.dev

# Intentionally below the 10 GB allowance to leave billing headroom.
R2_MAX_BYTES=8500000000
